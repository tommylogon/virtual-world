{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "rootDir": "static/js",
    "outDir": "static/js",
    "strict": true,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": false,
    "declaration": false,
    "newLine": "lf",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["static/js/**/*.ts"],
  "exclude": ["static/js/vendor/**"]
}
