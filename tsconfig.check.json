{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["static/js/**/*.js", "static/js/**/*.ts"],
  "exclude": ["static/js/vendor/**"]
}
