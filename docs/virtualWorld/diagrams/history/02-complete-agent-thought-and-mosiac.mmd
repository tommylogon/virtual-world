flowchart LR
    classDef root fill:#1e293b,stroke:#94a3b8,color:#f8fafc,stroke-width:1.5px
    classDef sensory fill:#0c4a6e,stroke:#38bdf8,color:#e0f2fe,stroke-width:1.5px
    classDef factual fill:#1e3a8a,stroke:#60a5fa,color:#dbeafe,stroke-width:2px
    classDef memory fill:#78350f,stroke:#f59e0b,color:#fef3c7,stroke-width:1.5px
    classDef mind fill:#312e81,stroke:#818cf8,color:#e0e7ff,stroke-width:1.5px
    classDef actor fill:#064e3b,stroke:#34d399,color:#d1fae5,stroke-width:2px
    classDef loop fill:#581c87,stroke:#e879f9,color:#fae8ff,stroke-width:1.5px
    classDef reject fill:#7f1d1d,stroke:#f87171,color:#fee2e2,stroke-width:1.5px

    subgraph S1["1. Turn N Inputs (World &amp; Self)"]
        direction TB
        OBS["Sensory Reality<br/>Surroundings, WITNESSED,<br/>Heard Speech, Vitals/Needs"]:::sensory
        FACT["Unvarnished Factual Lane<br/>carrying, spatial_memory,<br/>doors/locks, AlreadyKnown"]:::factual
        SELF["Disposition &amp; Affect<br/>Personality, Traits, Trauma,<br/>Mood, Relationships"]:::root
        GIMP["GIMP, Obligations &amp; Schedule<br/>Goals, Intention, Motivation,<br/>Pursuit, Duties, Routines"]:::root
        SEED["Memory Store &amp; Lived Log<br/>Player.memories + Life Exp<br/>+ Objective lived_log"]:::root
    end

    subgraph S2["2. Attention, Cueing &amp; Recall"]
        direction TB
        CUE["Extract Perceptual &amp; Somatic Cues<br/>actors, items, speech, needs, affect"]:::memory
        GATE{"Cue-Change Gate<br/>(salient shift?)"}:::memory
        RECALL["Involuntary Multi-Hop Recall<br/>(raw traces + lived_log refs)"]:::memory
        CACHE["Reuse Prior<br/>Conscious Summary"]:::memory
        DELIB["Deliberate 'recall' Action<br/>(active search on memory gap)"]:::memory
    end

    subgraph S3["3. Intermediator, Working Mind &amp; MOSIAC"]
        direction TB
        INTER["Memory Intermediator (LFM)<br/>Mood- &amp; Disposition-Biased<br/>Palimpsest Reconstruction"]:::memory
        CONSC["Conscious Memory Block<br/>(zero raw DB rows / logs)"]:::memory
        MIND["Active Working Mind<br/>Open Questions, Assumptions,<br/>Commitments"]:::mind
        MOSIAC["MOSIAC + Disposition Ranker<br/>M+I (GIMP), O+S, A (salience),<br/>C (gated verbs)"]:::mind
    end

    subgraph S4["4. Decision, Grounding &amp; Execution"]
        direction TB
        PLAN_CHK{"Active Plan Valid?<br/>(no threat / no failure)"}:::actor
        ACTOR["Actor LLM / Soak Policy<br/>Inner Monologue + Thought<br/>+ Plan + Speech/Intent"]:::actor
        INTERP["Action Interpreter &amp; PlanGrounding<br/>(validate against Factual Lane)"]:::actor
        REJECT["Grounding Rejection / Failure<br/>(invalidates false assumption)"]:::reject
        ACT["Execute Action &amp; Speech<br/>World Mutation, WITNESSED,<br/>Vitals &amp; Relationship Delta"]:::actor
    end

    subgraph S5["5. Reconsolidation, Dynamics &amp; Dreams (Turn N+1)"]
        direction TB
        PERSIST["Post-Turn Persistence<br/>Conscious Summary + Inner Monologue<br/>+ Outcome + Immutable Source Refs"]:::loop
        DYN["Memory Dynamics<br/>Reinforce / Fade / Supersede<br/>(invalid_at + lineage)"]:::loop
        SLEEP["Sleep / Dreams &amp; Daily Reflection<br/>consolidate_sleep() + daily_reflection.py<br/>Prune noise, form beliefs, update GIMP"]:::loop
        NEXT["Updated State for Turn N+1<br/>Player.memories · lived_log<br/>Active Mind · GIMP · Relations"]:::root
    end

    style S1 fill:#0f172a,stroke:#475569,color:#cbd5e1
    style S2 fill:#1c1917,stroke:#b45309,color:#fde68a
    style S3 fill:#1e1b4b,stroke:#6366f1,color:#c7d2fe
    style S4 fill:#022c22,stroke:#10b981,color:#a7f3d0
    style S5 fill:#2e1065,stroke:#c026d3,color:#f5d0fe

    %% 1 -> 2
    OBS --> CUE
    SELF -. "emotional lens" .-> CUE
    CUE --> GATE
    GATE -- "Yes (new cue)" --> RECALL
    GATE -- "No (unchanged)" --> CACHE
    SEED -. "raw traces & refs" .-> RECALL

    %% 2 -> 3
    RECALL --> INTER
    DELIB -. "targeted traces" .-> INTER
    OBS --> INTER
    SELF -. "mood & bias" .-> INTER
    INTER --> CONSC
    CACHE --> CONSC
    CONSC --> MIND
    GIMP --> MOSIAC
    SELF --> MOSIAC
    OBS --> MOSIAC

    %% 3 -> 4
    OBS --> PLAN_CHK
    MIND --> PLAN_CHK
    MOSIAC --> PLAN_CHK
    FACT --> PLAN_CHK
    PLAN_CHK -- "Replan / react" --> ACTOR
    PLAN_CHK -- "Continue step" --> INTERP
    ACTOR --> INTERP
    FACT --> INTERP
    INTERP -- "Valid" --> ACT
    INTERP -- "Blocked" --> REJECT
    REJECT -. "re-evaluate" .-> ACTOR
    ACTOR -. "needs recall" .-> DELIB

    %% 4 -> 5
    ACTOR -- "new Qs / assumptions" --> NEXT
    REJECT -- "disproves assumption" --> PERSIST
    ACT --> PERSIST
    ACTOR --> PERSIST
    CONSC --> PERSIST
    RECALL -. "source IDs" .-> PERSIST
    ACT --> NEXT
    PERSIST --> DYN
    DYN --> SLEEP
    DYN --> NEXT
    SLEEP --> NEXT
