# VirtualWorld — LLM provider credentials
#
# Copy this file to `.env` (it is gitignored) and fill in the keys you hold.
# Every provider below is OpenAI-compatible at the /chat/completions path, so the
# same client code reaches all of them by changing VW_LLM_BASE + VW_LLM_MODEL.
#
# Which key goes where, and what it costs you:
#
#   Provider        Trains on your prompts?   Free tier note
#   ------------    -----------------------   --------------------------------
#   Google AI Studio YES (unless UK/EEA/EU)    Gemini 1.5 Flash free, ~15 RPM
#   NVIDIA NIM       NO                       90+ models free, 40 RPM
#   Groq Cloud       NO                       Llama/Qwen/Mixtral, 30 RPM
#   Mistral AI      *opt-in*                  Experiment tier ~1 RPS, 500K TPM
#   OpenRouter       per-provider              20 RPM / 50 req/day unfunded;
#                                              1,000 req/day with $10 deposit
#
# If privacy matters more than price, prefer NVIDIA NIM or Groq Cloud: both
# explicitly do not train on your prompt history.
#
# Tooling that reads these:
#   tools/tasks.py  -> VW_LLM_BASE / VW_LLM_MODEL (task backfill, --content)
#   mcp_server.py   -> VIRTUAL_WORLD_URL / VIRTUAL_WORLD_TIMEOUT / VIRTUAL_WORLD_EDITOR
#   app.py          -> VW_PORT / VW_DEBUG

# ── Which provider is "active" ──────────────────────────────────────────────
# Pick ONE of the BASE values below. The MODEL must match the provider.
# Default is the local LM Studio endpoint (offline, no key, no data leaves the box).

VW_LLM_BASE=http://localhost:1234/v1
VW_LLM_MODEL=glm-4-9b-0414

# ── Google AI Studio (Gemini) ──────────────────────────────────────────────
# Trains on data if you are outside the UK/EEA/EU. Free Gemini 1.5 Flash.
# Rate limit is per-project, ~15 RPM typical.
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_BASE=https://generativelanguage.googleapis.com/v1
GOOGLE_GEMINI_MODEL=gemini-1.5-flash

# ── NVIDIA NIM ─────────────────────────────────────────────────────────────
# Does NOT train on your data. 90+ models, 40 RPM cap, no published daily cap.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=llama-3.3-70b-instruct

# ── Groq Cloud ─────────────────────────────────────────────────────────────
# Does NOT train on your data. Ultra-fast inference. 30 RPM.
GROQ_API_KEY=
GROQ_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ── Mistral AI ─────────────────────────────────────────────────────────────
# Trains on data only if you opt in. Experiment tier: ~1 RPS, ~500K TPM.
MISTRAL_API_KEY=
MISTRAL_BASE=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-large-latest

# ── OpenRouter ─────────────────────────────────────────────────────────────
# Routes through many providers; training policy depends on the underlying model.
# Unfunded: 20 RPM / 50 req/day. Funded ($10 deposit): 1,000 req/day.
OPENROUTER_API_KEY=
OPENROUTER_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-r1