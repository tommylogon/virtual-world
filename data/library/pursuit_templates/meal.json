{
  "id": "meal",
  "version": 2,
  "name": "Make and eat a meal",
  "purpose": "Gather food, bring it home, and eat it.",
  "parameters": {
    "food_spec": {
      "type": "item_spec",
      "required": false,
      "description": "What the character is gathering to eat (supply check only; the recipe defines the cook)."
    },
    "home": {
      "type": "area",
      "required": true,
      "description": "Where the character cooks and eats."
    }
  },
  "requirements": [
    {
      "type": "in_area",
      "target": "self",
      "area": {
        "$binding": "home"
      }
    }
  ],
  "steps": [
    {
      "kind": "travel",
      "area": {
        "$binding": "home"
      },
      "to": "home"
    },
    {
      "kind": "activity",
      "activity": "cooking",
      "recipe": "barley_pottage"
    },
    {
      "kind": "activity",
      "activity": "eating",
      "duration_minutes": 10
    }
  ],
  "tags": [
    "gathering",
    "cooking",
    "eating",
    "survival"
  ]
}