{
  "id": "scout-and-report",
  "version": 1,
  "name": "Scout and report",
  "purpose": "Go to a place that needs looking at, look at it, and report what was found back to the group.",
  "parameters": {
    "scout_area": {
      "type": "area",
      "required": true,
      "description": "The place the character is sent to look at."
    },
    "report_area": {
      "type": "area",
      "required": true,
      "description": "The place the character returns to with the report."
    }
  },
  "requirements": [
    {
      "type": "in_area",
      "area": {
        "$binding": "report_area"
      }
    }
  ],
  "supplies": [
    {
      "tags": [
        "drink"
      ],
      "name": null
    }
  ],
  "timing": {
    "daylight": true
  },
  "progress": [
    {
      "id": "reached_target",
      "description": "The scout arrived at the place that needed looking at.",
      "check": {
        "type": "in_area",
        "area": {
          "$binding": "scout_area"
        }
      }
    },
    {
      "id": "reported_back",
      "description": "The scout returned to the group with what was found.",
      "check": {
        "type": "in_area",
        "area": {
          "$binding": "report_area"
        }
      }
    }
  ],
  "stop_conditions": [
    {
      "type": "vital_below",
      "stat": "Energy",
      "value": 20
    }
  ],
  "steps": [
    {
      "kind": "travel",
      "area": {
        "$binding": "scout_area"
      },
      "to": "scout"
    },
    {
      "kind": "travel",
      "area": {
        "$binding": "report_area"
      },
      "to": "report"
    }
  ],
  "tags": [
    "scouting",
    "travel",
    "social"
  ]
}